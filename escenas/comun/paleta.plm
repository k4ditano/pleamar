// Los colores de casa. Una escena que quiera otro tono lo declara ella, con el
// mismo nombre, después de importar: el suyo gana.

library Palette {
    let ink  = #f5f7f5        // lo que se lee
    let mint = #9ed6bd        // el acento
    let sand = #e8c07a        // el segundo acento: avisos, «hay más»
    let coal = #151616        // el fondo de las píldoras y los paneles
}
