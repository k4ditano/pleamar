// Marea: la bolita, sus ojos y la tarjeta de aviso que le nace del costado.
//
// Todo lo que hay en este fichero lo ejecuta el render, solo: abrirse al pasar
// el ratón, cerrarse al irse, dormirse, realzar el botón. La lógica se limita a
// decir qué pone el aviso y a enterarse de que alguien pulsó «Ver evento».

scene Marea {
    surface {
        size: 720, 224
        anchor: top
        margin: 40
        screens: "HDMI-A-1"
    }

    // ── la frontera con la lógica ────────────────────────────────
    fact open = false
    fact asleep = false
    event view_event ->

    text notice.app    = "CALENDARIO"
    text notice.when   = "Ahora"
    text notice.title  = "Reunión en 5 min"
    text notice.detail = "Revisión de diseño · 18:00"

    // ── lo que se mueve ──────────────────────────────────────────
    prop orb.x   = 360
    prop orb.y   = 90
    prop panel.w = 0
    prop panel.h = 0
    prop neck    = 0          // cuánto se funden bolita y tarjeta
    prop content = 0
    prop sleep   = 0
    prop glow    = 0          // el realce del botón
    prop eyelid  = 1
    prop breath  = 0
    prop gaze.x  = 0 ~eyes
    prop gaze.y  = 0 ~eyes

    let panel.x = orb.x + 62
    let panel.y = orb.y - 70
    //  Estirarse con la velocidad: el render la conoce; la lógica, nunca.
    let stretch = clamp((abs(vel(orb.x)) - abs(vel(orb.y))) / 2400, -0.22, 0.22)

    //  La zona de todo el conjunto, debajo de las demás: las que se declaran
    //  después quedan encima. Solo existe mientras hay tarjeta; cerrada, por ahí
    //  el clic pasa a lo de debajo.
    zone box whole { at: 360, 115; size: 532, 226; corner: 24; active: open or panel.w > 1 }

    // ── quién manda ──────────────────────────────────────────────
    //  Abrir y cerrar son dos reclamaciones de la misma capa, cada una con su
    //  coreografía. Quien ponga `open` no sabe nada de muelles.
    layer card ~calm {
        shown while open {
            neck:    96  ~quick
            orb.x:   140 ~lively
            panel.w: 406 ~calm after 70ms
            panel.h: 190 ~calm after 110ms
            content: 1   ~calm after 300ms
            neck:    0   ~calm after 560ms
        }
        rest {
            glow:    0   ~quick
            content: 0   ~quick
            neck:    96  ~quick
            panel.h: 0   ~calm after 90ms
            panel.w: 0   ~calm after 90ms
            orb.x:   360 ~lively after 150ms
            neck:    0   ~calm after 700ms
        }
    }
    layer slumber ~slow {
        sleeping while asleep and not open { sleep: 1 ~slow }
        awake { sleep: 0 ~lively }
    }

    // ── el dibujo ────────────────────────────────────────────────
    //  Un solo cuerpo: bolita y tarjeta fundidas por un cuello de agua.
    body {
        color: #151616
        rim: 5%
        light: 3%, orb.y - 70, 190
        shadow: 0, 10, 30, 34%

        ellipse orb {
            at: orb.x, orb.y
            radius: 28 + breath
            scale: 1 + stretch, 1 / (1 + stretch)
        }
        box {
            from: panel.x, orb.y - panel.h * 70 / 190
            size: panel.w, panel.h
            corner: 24
            blend: neck * smooth(0, 40, panel.w)
        }
    }

    //  Lo de dentro de la tarjeta: recortado a lo que lleve crecido, y fundido
    //  como una sola cosa.
    group {
        clip inset 1 box {
            from: panel.x, orb.y - panel.h * 70 / 190
            size: panel.w, panel.h
            corner: 24
        }
        group {
            opacity: content

            box dismiss { at: panel.x + 110, panel.y + 151; size: 168, 46; corner: 9; color: #2e2f2f; active: content }
            box view {
                at: panel.x + 296, panel.y + 151
                size: 168 + glow * 4, 46 + glow * 3
                corner: 9
                color: mix(#9ed6bd, #bdeed6, glow)
                active: content
            }

            text notice.app    { at: panel.x + 26,  panel.y + 33; anchor: left center;  size: 12.5; color: #f5f7f5; opacity: 62% }
            text notice.when   { at: panel.x + 380, panel.y + 33; anchor: right center; size: 13.5; color: #f5f7f5; opacity: 55% }
            text notice.title  { at: panel.x + 26,  panel.y + 71; anchor: left center;  size: 20; weight: 500; width: 354; lines: 1; color: #f5f7f5 }
            text notice.detail { at: panel.x + 26,  panel.y + 99; anchor: left center;  size: 14.5; width: 354; lines: 1; color: #f5f7f5; opacity: 60% }
            text "Descartar"   { at: panel.x + 110, panel.y + 151; anchor: center; size: 15; weight: 500; color: #f5f7f5; opacity: 95% }
            text "Ver evento"  { at: panel.x + 296, panel.y + 151; anchor: center; size: 15; weight: 500; color: #121f1a }
        }
    }

    //  Los ojos: dos píldoras recortadas a la cara.
    group {
        clip inset 3 ellipse { at: orb.x, orb.y; radius: 28 }
        box { at: orb.x + gaze.x - 8.6, orb.y + gaze.y + sleep * 3 - 1; size: 7, 16.8 * max(eyelid * (1 - sleep), 0.14); corner: 3.5; color: #f5f7f5 }
        box { at: orb.x + gaze.x + 8.6, orb.y + gaze.y + sleep * 3 - 1; size: 7, 16.8 * max(eyelid * (1 - sleep), 0.14); corner: 3.5; color: #f5f7f5 }
    }

    // ── lo que lleva sola ────────────────────────────────────────
    blink eyelid every 2.4s..6s for 170ms
    wave breath = sleep * 1.3 at 1.7
    look gaze.x, gaze.y at orb.x, orb.y reach 5, 3.2 within 140 rest panel.w * 3.2 / 406, panel.w * 0.6 / 406

    // ── qué hace cambiar las cosas ───────────────────────────────
    on enter orb             { asleep = false }
    on hover orb for 320ms   { open = true }
    on press orb             { toggle open }
    on away whole for 420ms  { open = false }
    on enter view            { glow: 1 ~quick }
    on leave view            { glow: 0 ~quick }
    on press dismiss         { open = false }
    on press view            { open = false; impulse orb.y -620; emit view_event }
    on idle for 14s while not open { asleep = true }

    //  Sin ratón: `--demo` hace de aviso que llega y se va.
    on demo                  { toggle open }
}
