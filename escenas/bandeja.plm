// Una bandeja de avisos: lo que el lenguaje no podía hacer sin componentes,
// `repeat` y reparto. La lista crece y encoge con un hecho; nadie calcula
// posiciones: cada aviso va a su hueco con el muelle de la columna.

scene Tray {
    surface { size: 720, 430; anchor: top; margin: 40; screens: "HDMI-A-1" }
    //  Lo que `bandeja.luau` puede tocar: ser quien recibe las notificaciones.
    permissions { services: "notifications" }

    let ink  = #f5f7f5
    let mint = #9ed6bd
    let sand = #e8c07a

    // ── la frontera con la lógica ────────────────────────────────
    //  Los avisos son una lista que pone la lógica (bandeja.luau), tal como se la
    //  da el sistema. Caben cinco a la vez; cuántos hay de verdad es `notes.total`.
    model notes max 5 {
        app: text
        title: text
        body: text
        urgency: number = 1               // 0 poca · 1 normal · 2 crítica
    }
    event opened ->                       // lleva dentro cuál: `emit opened(n.index)`

    // ── piezas ───────────────────────────────────────────────────
    //  Una etiqueta que mide lo que mida su texto: el `row` de dentro le da el
    //  tamaño, y con él el de la copia entera.
    component Chip(label, tone) {
        row { padding: 7; fill: tone; corner: 13
            text label { size: 12.5; weight: 500; color: #121f1a }
        }
    }

    //  Un aviso. Cada copia tiene su propio `lit` y su propia zona `hit`: dos
    //  copias no se pisan, y la regla de dentro habla de las suyas.
    component Note(n) {
        size: 360, 58
        prop lit = 0 ~quick

        body {
            color: mix(#1b1c1c, #2b2d2d, lit)
            rim: 4%
            shadow: 0, 6, 18, 22%
            box hit { from: 0, 0; size: 360, 58; corner: 14 }
        }
        //  La raya dice cuánta prisa tiene.
        box { from: 0, 14; size: 3, 30; corner: 1.5; color: mix(mint, #e8776a, max(n.urgency - 1, 0)) }
        text n.app { at: 16, 19; anchor: left center; size: 10.5; color: ink; opacity: 55% }
        //  El título, y a su lado lo que dice: el cuerpo empieza donde el título acabe.
        group {
            clip box { from: 12, 24; size: 336, 28 }
            row { at: 16, 28; gap: 8; align: center
                text n.title { size: 14.5; weight: 500; color: ink }
                text n.body  { size: 13.5; color: ink; opacity: 60% }
            }
        }

        on enter hit { lit: 1 ~quick }
        on leave hit { lit: 0 ~quick }
        on press hit { emit opened(n.index) }
    }

    // ── la escena ────────────────────────────────────────────────
    row head ~calm {
        at: 180, 22
        gap: 8
        align: center
        text "Avisos" { size: 19; weight: 600; color: ink }
        space 6
        Chip("nuevos", mint)
        Chip("hay más", sand) { show: notes.total > 5 }
    }

    column list ~calm {
        at: 180, 66
        gap: 8
        for n in notes { Note(n) }
    }

    //  Una raya que sigue al final de la lista: sabe cuánto mide sin que nadie se lo diga.
    box { from: 180, 66 + list.height + 10; size: head.width, 2; corner: 1; color: ink; opacity: 18% }

}
