// Una escena sin lógica propia que usa un plugin. El reloj pone la hora él solo:
// la escena no sabe ni de `date` ni de cada cuánto. Y no le ha dado ningún permiso.

import "comun/paleta.plm"
import "plugins/reloj.plm"

scene WithPlugin {
    surface { size: 300, 60; anchor: top; margin: 60; screens: "HDMI-A-1" }
    row { at: 150, 12; anchor: center; gap: 10; align: center
        Clock(tone: mint)
        //  La frontera de un plugin se puede leer desde fuera, por su nombre entero.
        text "{? segundos: {Clock.seconds}}" { size: 11; color: ink; opacity: 50% }
    }
}
