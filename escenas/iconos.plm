// La bandeja del sistema: los iconos de las aplicaciones que siguen vivas sin
// ventana. Pulsar uno es su clic de siempre; el botón derecho abre su menú, que
// es una superficie emergente: sale de la barra y se pinta como todo lo demás.

scene TrayIcons {
    surface { size: 420, 52; anchor: top; margin: 60; screens: "HDMI-A-1" }
    //  Lo que `iconos.luau` puede tocar: la bandeja, y nada más.
    permissions { services: "tray" }

    let ink  = #f5f7f5
    let mint = #9ed6bd
    let coal = #151616

    // ── la frontera ──────────────────────────────────────────────
    fact count = 0                        // cuántos iconos hay, hasta 8
    fact menu_open = false
    fact slot = 0                         // de qué icono es el menú abierto
    fact rows = 0                         // cuántas filas tiene, hasta 14
    repeat i in 0..8 {
        text pic.$i = ""
        image icon.$i = from pic.$i, 28, 28
    }
    repeat i in 0..14 {
        text row.$i = ""
        fact sep.$i = 0                   // es una raya
        fact off.$i = 0                   // no se puede pulsar
        fact sub.$i = 0                   // lleva a otro menú
        fact chk.$i = 0                   // 1: casilla vacía · 2: marcada
    }
    event activate ->                     // (i): el clic de siempre
    event menu ->                         // (i): quiere ver su menú
    event choose ->                       // (i): ha elegido esa fila

    // ── la píldora ───────────────────────────────────────────────
    row icons ~quick {
        at: 210, 0
        anchor: center
        padding: 10
        gap: 10
        fill: coal
        corner: 23
        repeat i in 0..8 { Icon(i) { show: count > i } }
    }

    component Icon(i) {
        size: 32, 32
        prop lift = 0 ~lively
        box hit { from: 0, 0; size: 32, 32; corner: 9; color: ink; opacity: lift * 12%; cursor: pointer }
        image icon.$i { at: 2, 2; size: 28, 28 }
        on enter hit       { lift: 1 ~quick }
        on leave hit       { lift: 0 ~quick }
        on press hit       { emit activate(i) }
        on press right hit { slot = i; emit menu(i) }
    }

    // ── el menú ──────────────────────────────────────────────────
    //  Debajo de su icono, y tan alto como su lista.
    popup tray_menu {
        at: 210 - icons.width / 2 + 10 + slot * 42 - 8, 50
        size: 236, 16 + list.height
        open: menu_open

        body { color: #1b1c1c; border: 1, #38393a
            box { from: 0, 0; size: 236, 16 + list.height; corner: 12 } }
        column list { at: 8, 8
            repeat i in 0..14 { Row(i) { show: rows > i } }
        }
    }

    component Row(i) {
        size: 220, 30 - sep.$i * 21
        prop on = 0 ~quick
        box hit { from: 0, 0; size: 220, 30 - sep.$i * 21; corner: 7; color: mint
                  opacity: on * 20% * (1 - sep.$i) * (1 - off.$i); cursor: pointer }
        //  La raya de un separador.
        box { from: 6, 4; size: 208, 1; color: ink; opacity: sep.$i * 14% }
        text row.$i { at: 12, 15; anchor: left center; size: 13.5; width: 170; lines: 1; color: ink
                      opacity: (1 - sep.$i) * (1 - off.$i * 0.55) }
        //  Una casilla marcada, o la flecha de «hay más».
        ellipse { at: 204, 15; radius: 3.5; color: mint; opacity: if(chk.$i > 1.5, 1, 0) }
        ellipse { at: 204, 15; radius: 3.5; stroke: 1.2; color: ink; opacity: if(chk.$i > 0.5, 0.5, 0) }
        text "›" { at: 204, 14; anchor: center; size: 16; color: ink; opacity: sub.$i * 0.6 }
        on enter hit { on: 1 ~quick }
        on leave hit { on: 0 ~quick }
        on press hit { emit choose(i) }
    }
}
