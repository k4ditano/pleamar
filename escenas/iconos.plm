// La bandeja del sistema: los iconos de las aplicaciones que siguen vivas sin
// ventana. Pulsar uno es su clic de siempre; el botón derecho abre su menú, que
// es una superficie emergente: sale de la barra y se pinta como todo lo demás.

import "comun/paleta.plm"
import "comun/menu.plm"

scene TrayIcons {
    surface { size: 420, 52; anchor: top; margin: 60; screens: "HDMI-A-1" }
    //  Lo que `iconos.luau` puede tocar: la bandeja, y nada más.
    permissions { services: "tray" }


    // ── la frontera: dos listas que pone la lógica ───────────────
    model icons max 8 { icon: text }
    model rows max 14 {
        label: text
        separator: bool
        enabled: bool = true
        checked: number = -1              // -1: no es una casilla · 0: vacía · 1: marcada
        children: number                  // cuántos tiene dentro: lleva a otro menú
    }
    fact menu_open = false
    fact slot = 0                         // de qué icono es el menú abierto
    event activate ->                     // (i): el clic de siempre
    event menu ->                         // (i): quiere ver su menú
    event choose ->                       // (i): ha elegido esa fila

    // ── la píldora ───────────────────────────────────────────────
    row tray ~quick {
        at: 210, 0
        anchor: center
        padding: 10
        gap: 10
        fill: coal
        corner: 23
        for i in icons { Icon(i) }
    }

    component Icon(i) {
        size: 32, 32
        prop lift = 0 ~lively
        image pic = from i.icon, 28, 28
        box hit { from: 0, 0; size: 32, 32; corner: 9; color: ink; opacity: lift * 12%; cursor: pointer }
        image pic { at: 2, 2; size: 28, 28 }
        on enter hit       { lift: 1 ~quick }
        on leave hit       { lift: 0 ~quick }
        on press hit       { emit activate(i.index) }
        on press right hit { slot = i.index; emit menu(i.index) }
    }

    // ── el menú ──────────────────────────────────────────────────
    //  Debajo de su icono, y tan alto como su lista.
    popup tray_menu {
        at: 210 - tray.width / 2 + 10 + slot * 42 - 8, 50
        size: 236, 16 + list.height
        open: menu_open

        body { color: #1b1c1c; border: 1, #38393a
            box { from: 0, 0; size: 236, 16 + list.height; corner: 12 } }
        column list { at: 8, 8
            for r in rows { MenuRow(r, chosen: choose) }
        }
    }
}
