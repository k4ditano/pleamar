// espera: bien
language 0.1
// `open:` acepta una cuenta, no solo un hecho: la superficie sigue ahí mientras lo
// que lleva dentro termina de irse. Y un `clip` suelto de la escena acaba donde
// empieza una superficie con nombre: es otra ventana, y empieza limpia.
scene Corner {
    surface { size: 200, 60; anchor: top }
    fact tucked = false
    prop tuck = 0 ~lively
    follow tuck = if(tucked, 1, 0)

    box { from: 0, 0; size: 200, 60; color: #151616 }
    clip box { from: 0, 0; size: 10, 10 }
    box { from: 0, 0; size: 200, 60; color: #9ed6bd }

    surface corner {
        size: 120, 120; anchor: top_right; level: overlay
        open: tuck > 0.01
        ellipse { at: 105 + (1 - tuck) * 44, 15 - (1 - tuck) * 44; radius: 23; color: #151616 }
    }
}
