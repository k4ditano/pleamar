// espera: bien
// Las anclas y los niveles de una superficie: una escena tiene una sola, así que van de una en una.
scene Surface1 {
    surface { size: 200, 60; anchor: top_left; margin: 8, 12, 8, 12; level: bottom; reserve: 0; screens: all }
    box { at: 100, 30; size: 180, 40; corner: 20; color: #151616 }
}
