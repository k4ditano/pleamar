// espera: bien
language 0.1
// Una lista más larga que lo que despliega: `content:` dice cuánto hay de verdad,
// `from` numera las copias desde donde toca, y el desplazamiento es una propiedad.
scene Window {
    surface { size: 300, 260 }
    let ink = #f5f7f5
    let step = 30
    model rows max 8 { label: text }
    fact total = 0
    fact first = 0
    event slid ->

    column list {
        at: 10, 10
        view: 280, 200
        step: step
        content: ceil(total) * step
        for r in rows from first {
            group {
                size: 280, step
                move: 0, first * step
                text r.label { at: 8, 15; anchor: left center; size: 12; color: ink }
                text number(r.index, 0) { at: 270, 15; anchor: right center; size: 10; color: ink; opacity: 40% }
            }
        }
    }
    text number(floor(list.scroll / step) + 1, 0) { at: 10, 230; size: 11; color: ink }
    on scroll list { emit slid(list.scroll) }
    on press list { list.scroll: 0 ~calm }
}
