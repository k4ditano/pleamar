// espera: bien
language 0.1
// Un cuerpo de cristal: tinte, luz en los cantos, y el compositor desenfoca lo de detrás.
scene Cristal {
    prop cerca = 0 ~calm
    surface { size: 300, 160; anchor: top }
    body {
        color: #1b2127
        glass: 60% + cerca * 40%
        lens: cerca > 0.5
        shadow: 0, 8, 22, 28%
        box { at: 150, 80; size: 240, 110; corner: 28 }
    }
    zone box encima { at: 150, 80; size: 240, 110; corner: 28 }
    on enter encima { cerca: 1 }
    on leave encima { cerca: 0 }
    //  Y dentro, placas: una forma suelta y el fondo de un reparto.
    box { at: 90, 80; size: 80, 60; corner: 14; color: #4a5057; glass: 100% }
    row { at: 150, 55; padding: 8; fill: #4a5057; glass: 100%; corner: 12
        text "placa" { size: 12; color: #f5f7f5 }
    }
    //  Un velo: un fondo que apenas se ve.
    row { at: 150, 110; padding: 8; fill: #f5f7f5 9%; corner: 12
        text "placa" { size: 12; color: #f5f7f5 }
    }
}
