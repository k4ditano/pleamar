// espera: bien
language 0.1
// Una ventana normal: `kind: window`, con su título. Lo que dibuja se mide contra
// lo que mide ella, que cambia cuando alguien la estira.
scene Win {
    surface { size: 420, 280; kind: window; title: "pleamar · prueba" }
    let ink = #f5f7f5
    let w = screen.width
    let h = screen.height
    box { from: 0, 0; size: w, h; color: #151616 }
    text "una ventana" { at: 20, 24; size: 15; color: ink }
    box { at: w - 60, h - 30; size: 100, 34; corner: 10; color: #232727 }
}
