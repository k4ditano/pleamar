// espera: bien
language 0.1
// `sin` y `cos`, en grados: lo que hace falta para poner algo en un arco. Aquí
// cuatro gotas bajan por el lado de una bola, y el sitio de cada una viaja POR
// EL ARCO porque lo que se anima es el ángulo, no la x y la y.
scene Arco {
    surface { size: 120, 120; anchor: top }
    ellipse { at: 60, 60; radius: 23; color: #151616 }
    repeat k in 0..4 {
        prop sitio.$k = 0 ~calm
        follow sitio.$k = k
        let ang.$k = -24 + 26 * sitio.$k
        ellipse { at: 60 + 31.7 * cos(ang.$k), 60 + 31.7 * sin(ang.$k); radius: 7; color: #6fb1e6 }
    }
}
