// espera: bien
language 0.1
// `rate: 30`: como mucho treinta frames por segundo, en cualquier monitor.
// Lo que consume una escena que siempre se mueve deja de depender de la
// pantalla que le toque.
scene Ritmo {
    surface { size: 200, 80; anchor: top; rate: 30 }
    prop t = 0
    wave t = 1 at 0.5
    box { at: 100 + t * 40, 40; size: 20, 20; corner: 6; color: #9ed6bd }
}
