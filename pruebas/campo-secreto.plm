// espera: bien
language 0.1
// Un campo de contraseña: se escribe igual, se pinta en puntos, y lo que lleva
// no sale en ningún log. La comprobación es de la lógica: sys.ask("auth.check", …).
scene Clave {
    surface { size: 300, 80; anchor: top; keyboard: on_demand }
    permissions { services: "auth" }
    text clave = ""
    box { from: 20, 20; size: 260, 40; corner: 10; color: #202021 }
    input clave { at: 34, 30; width: 232; size: 15; color: #ffffff; placeholder: "password"; secret: true }
}
