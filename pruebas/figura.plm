// espera: bien
// Un SVG como geometría: entera, por capas, teñida y fundida en un cuerpo.
scene Figura {
    surface { size: 200, 120; anchor: center }
    figure pieza = file "comun/pieza.svg"

    prop gira = 0 ~quick

    figure pieza { at: 40, 60; size: 40, 40 }
    figure pieza.fondo { at: 100, 60; size: 40, 40; pivot: -8, 4; rotate: gira * 12deg }
    figure pieza.punto { at: 100, 60; size: 40, 40; color: #9ed6bd }
    body {
        color: #151616
        ellipse { at: 160, 60; radius: 16 }
        figure pieza.fondo { at: 160, 46; size: 30, 30; blend: 6 }
    }
}
