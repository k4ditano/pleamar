// espera: bien
language 0.1
// Un camino: quebrado, con curvas, cerrado y relleno, con trazo, girado y fundido.
scene Path {
    surface { size: 300, 220 }
    let ink = #f5f7f5
    prop wobble = 0
    wave wobble = 1 at 1.2

    //  Abierto: una línea con grosor.
    path { at: 20, 20; stroke: 2; color: ink
        move 0, 40
        line 30, 20 + wobble * 4
        curve 90, 30 via 60, 0
        line 120, 10
    }

    //  Cerrado: se rellena, y se funde con lo de al lado.
    body {
        color: #9ed6bd; shadow: 0, 4, 10, 30%
        path lid { at: 20, 110; blend: 8; rotate: 0.2
            move 30, 0
            line 60, 18
            line 60, 52
            line 30, 70
            line 0, 52
            line 0, 18
            close
        }
        ellipse { at: 110, 145; radius: 14; blend: 8 }
    }

    //  En un reparto hay que decir lo que ocupa.
    row { at: 170, 120; gap: 8
        path { size: 40, 40; color: #e8c07a
            move 0, 40
            line 20, 0
            line 40, 40
            close
        }
        path { size: 40, 40; stroke: 2; color: ink
            move 0, 0
            curve 40, 40 via 40, 0
        }
    }

    on press lid { wobble: 1 }
}
