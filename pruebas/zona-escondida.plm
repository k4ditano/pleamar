// espera: bien
language 0.1
// Lo escondido no caza el ratón: la zona de la lista de la otra página no
// puede quitarle el clic a lo que sí se ve.
scene Escondida {
    surface { size: 200, 120 }
    fact abierta = false
    box tarjeta { at: 100, 40; size: 160, 40; corner: 10; color: #202021 }
    group {
        show: abierta
        box tapa { at: 100, 40; size: 160, 40; corner: 10; color: #9ed6bd }
        on press tapa { abierta = false }
    }
    on press tarjeta { abierta = true }
}
