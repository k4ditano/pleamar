// espera: bien
language 0.1
// Varias ventanas en un proceso: una barra que siempre está y un panel que sale
// cuando ella lo dice. Comparten hechos, propiedades y reglas; ninguna sabe de la otra.
scene TwoSurfaces {
    let ink = #f5f7f5
    fact open = false
    fact count = 3
    prop lift = 0 ~quick

    surface { size: full, 40; anchor: top; screens: all }
    box strip { at: screen.width / 2, 20; size: screen.width, 40; color: #151616 }
    box knob { at: 40, 20; size: 60, 24; corner: 12; color: mix(#2e2f2f, #9ed6bd, lift); cursor: pointer }
    text "{count} avisos" { at: 120, 20; anchor: left center; size: 13; color: ink }
    on enter knob { lift: 1 ~quick }
    on leave knob { lift: 0 ~quick }
    on press knob { toggle open }

    surface panel {
        size: 300, 160
        anchor: top_right
        margin: 48, 12, 0, 0
        level: overlay
        open: open
        body { color: #1b1c1c; rim: 4%; box { from: 0, 0; size: 300, 160; corner: 16 } }
        text "Panel" { at: 16, 24; anchor: left center; size: 15; weight: 600; color: ink }
        box close { at: 270, 24; size: 28, 24; corner: 8; color: #2e2f2f; cursor: pointer }
        column { at: 16, 48; gap: 6
            repeat i in 0..3 { text "fila {i}" { size: 13; color: ink; show: count > i } }
        }
        on press close { open = false }
    }
}
