// Five thousand rows in sixteen copies.
//
// A list is not laid out whole: the scene declares the **window** —what fits in
// view and a little more— and says how long the real list is with `content:`. It
// moves with the wheel, by dragging or in one jump; when it crosses a row, the scene
// asks the logic for the slice that belongs, and the same sixteen copies show other
// records. What tells it is `on change`, which does not know where the movement came from.
//
// What it costs does not depend on how many there are: sixteen groups, sixteen zones.

import "common/palette.plm"

scene LongList {
    surface { size: 420, 462; anchor: center }

    let step = 34
    let window = 16

    //  The window: the only thing laid out.
    model rows max 16 { label: text; tag: text }
    fact total = 0                 // how many there really are, from the logic
    fact first = 0                 // which one the window is at, from the logic
    event slid ->                  // «it moved, send me from here»

    box { from: 0, 0; size: 420, 462; corner: 16; color: coal }

    column list {
        at: 10, 10
        gap: 0
        view: 400, 400
        step: step
        content: total * step      // the length of the whole list, not the window's

        //  `from first`: copy 0 is record `first` of the real list.
        for r in rows from first {
            group {
                size: 400, step
                //  The copies sit in their place in the whole list, not in the window's.
                move: 0, first * step

                zone box hit { from: 2, 1; size: 396, 32; corner: 8; cursor: pointer }
                prop hot = 0 ~quick
                on enter hit { hot: 1 }
                on leave hit { hot: 0 }

                box { from: 2, 1; size: 396, 32; corner: 8; color: mix(#202222, mint, hot * 0.25) }
                text "{r.index}" { at: 14, 17; anchor: left center; size: 11; color: ink; opacity: 35% }
                text r.label { at: 56, 17; anchor: left center; size: 12.5; color: ink }
                text r.tag { at: 388, 17; anchor: right center; size: 11; color: sand; opacity: 70% }
            }
        }
    }

    //  The scrollbar: what is seen, over what there is.
    let bar_h = max(400 * 400 / max(total * step, 400), 24)
    box { at: 410, 10 + list.scroll / max(total * step - 400, 1) * (400 - bar_h); size: 4, bar_h; corner: 2; color: mint; opacity: 45% }

    //  Below: where it is, and two jumps. The scroll is a property like any
    //  other, so a rule can take it wherever it wants.
    row footer { at: 12, 424; gap: 10; align: center
        group {
            size: 150, 26
            text number(floor(list.scroll / step) + 1, 0) { at: 0, 13; anchor: left center; size: 11; color: ink; opacity: 45% }
            text number(ceil(total), 0) { at: 60, 13; anchor: left center; size: 11; color: ink; opacity: 25% }
        }
        group {
            size: 60, 26
            zone box up { from: 0, 0; size: 60, 26; corner: 8; cursor: pointer }
            box { from: 0, 0; size: 60, 26; corner: 8; color: #202222 }
            text "top" { at: 30, 13; anchor: center; size: 11; color: ink }
            on press up { list.scroll: 0 ~calm; emit slid(0) }
        }
        group {
            size: 60, 26
            zone box down { from: 0, 0; size: 60, 26; corner: 8; cursor: pointer }
            box { from: 0, 0; size: 60, 26; corner: 8; color: #202222 }
            text "end" { at: 30, 13; anchor: center; size: 11; color: ink }
            on press down { list.scroll: total * step - 400 ~calm; emit slid(total * step - 400) }
        }
    }

    //  When the list crosses a row —with the wheel, by dragging or in one jump—,
    //  the logic finds out and sends the slice that belongs. How it moved does not matter.
    on change floor(list.scroll / step) { emit slid(list.scroll) }
}
