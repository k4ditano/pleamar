// Five thousand rows in sixteen copies.
//
// A list is not laid out whole: the model is the **window** —what fits in view and
// a little more—, and the layout works it out by itself. With `view:` and a `for`
// in it, it makes `list.first` (the record the window starts at) and moves it as
// the list moves —with the wheel, by dragging or in one jump—; the logic hears it
// and sends the slice from there, and says how long the whole list is in
// `list.total`. The copies sit where their records are, and the length to scroll
// over is the whole list's.
//
// What it costs does not depend on how many there are: sixteen groups, sixteen zones.

import "common/palette.plm"

scene LongList {
    surface { size: 420, 462; anchor: center }

    let step = 34
    let window = 16

    //  The window: the only thing laid out.
    model rows max 16 { label: text; tag: text }

    box { from: 0, 0; size: 420, 462; corner: 16; color: coal }

    column list {
        at: 10, 10
        gap: 0
        view: 400, 400
        step: step

        //  Copy 0 is record `list.first` of the whole list, and sits where it is.
        for r in rows {
            group {
                size: 400, step

                zone box hit { from: 2, 1; size: 396, 32; corner: 8; cursor: pointer }
                prop hot = 0 ~quick
                on enter hit { hot: 1 }
                on leave hit { hot: 0 }

                box { from: 2, 1; size: 396, 32; corner: 8; color: mix(#202222, mint, hot * 0.25) }
                text "{r.index}" { at: 14, 17; anchor: left center; size: 11; color: ink; opacity: 35% }
                text r.label { at: 56, 17; anchor: left center; size: 12.5; color: ink }
                text r.tag { at: 388, 17; anchor: right center; size: 11; color: sand; opacity: 70% }
            }
        }
    }

    //  The scrollbar: what is seen, over what there is.
    //  (Written out, not in a `let`: the layout makes `list.total` while it is read, and a loose `let` is read before.)
    box { at: 410, 10 + list.scroll / max(list.total * step - 400, 1) * (400 - max(400 * 400 / max(list.total * step, 400), 24)); size: 4, max(400 * 400 / max(list.total * step, 400), 24); corner: 2; color: mint; opacity: 45% }

    //  Below: where it is, and two jumps. The scroll is a property like any
    //  other, so a rule can take it wherever it wants.
    row footer { at: 12, 424; gap: 10; align: center
        group {
            size: 150, 26
            text number(floor(list.scroll / step) + 1, 0) { at: 0, 13; anchor: left center; size: 11; color: ink; opacity: 45% }
            text number(ceil(list.total), 0) { at: 60, 13; anchor: left center; size: 11; color: ink; opacity: 25% }
        }
        group {
            size: 60, 26
            zone box up { from: 0, 0; size: 60, 26; corner: 8; cursor: pointer }
            box { from: 0, 0; size: 60, 26; corner: 8; color: #202222 }
            text "top" { at: 30, 13; anchor: center; size: 11; color: ink }
            on press up { list.scroll: 0 ~calm }
        }
        group {
            size: 60, 26
            zone box down { from: 0, 0; size: 60, 26; corner: 8; cursor: pointer }
            box { from: 0, 0; size: 60, 26; corner: 8; color: #202222 }
            text "end" { at: 30, 13; anchor: center; size: 11; color: ink }
            on press down { list.scroll: list.total * step - 400 ~calm }
        }
    }

}
