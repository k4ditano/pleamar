// A notice tray: what the language could not do without components,
// `repeat` and layout. The list grows and shrinks with a fact; nobody computes
// positions: each notice goes to its slot with the column's spring.

import "common/palette.plm"

scene Tray {
    surface { size: 720, 430; anchor: top; margin: 40; screens: "HDMI-A-1" }
    //  What `tray.luau` may touch: being the one who receives the notifications.
    permissions { services: "notifications", "notifications.*" }


    // ── the boundary with the logic ──────────────────────────────
    //  The notices are a list the logic fills (tray.luau), just as the system
    //  hands it over. Five fit at a time; how many there really are is `notes.total`.
    model notes max 5 {
        app: text
        title: text
        body: text
        urgency: low | normal | critical = normal
    }
    event opened ->                       // carries which one inside: `emit opened(n.index)`

    // ── pieces ───────────────────────────────────────────────────
    //  A label that measures whatever its text measures: the `row` inside gives it the
    //  size, and with it the size of the whole copy.
    component Chip(label: text, tone: color) {
        row { padding: 7; fill: tone; corner: 13
            text label { size: 12.5; weight: 500; color: #121f1a }
        }
    }

    //  One notice. Each copy has its own `lit` and its own `hit` zone: two
    //  copies do not step on each other, and the rule inside talks about its own.
    component Note(n: record) {
        size: 360, 58
        prop lit = 0 ~quick

        body {
            color: mix(#1b1c1c, #2b2d2d, lit)
            rim: 4%
            shadow: 0, 6, 18, 22%
            box hit { from: 0, 0; size: 360, 58; corner: 14 }
        }
        //  The stripe says how much of a hurry it is in.
        box { from: 0, 14; size: 3, 30; corner: 1.5; color: mix(mint, #e8776a, n.urgency == critical) }
        text "{upper(n.app)}" { at: 16, 19; anchor: left center; size: 10.5; color: ink; opacity: 55% }
        //  The title and, if it brings one, what it says. With no body, no « · » either.
        text "{n.title}{? · {n.body}}" { at: 16, 38; anchor: left center; size: 14.5; weight: 500; width: 328; lines: 1; color: ink }

        on enter hit { lit: 1 ~quick }
        on leave hit { lit: 0 ~quick }
        on press hit { emit opened(n.index) }
    }

    // ── the scene ────────────────────────────────────────────────
    row head ~calm {
        at: 180, 22
        gap: 8
        align: center
        text "Notices" { size: 19; weight: 600; color: ink }
        space 6
        Chip("new", mint)
        Chip("more", sand) { show: notes.total > 5 }
    }

    column list ~calm {
        at: 180, 66
        gap: 8
        for n in notes { Note(n) }
    }

    //  A stripe that follows the end of the list: it knows how tall it is without being told.
    box { from: 180, 66 + list.height + 10; size: head.width, 2; corner: 1; color: ink; opacity: 18% }

}
