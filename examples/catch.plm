// Star catcher: a small game, to see that pleamar can hold one. The boat goes
// where the arrows, A and D, or a game controller's stick say; the stars that
// fall are to be caught before they reach the water.
// `pleamar --scene examples/catch.plm`
language 0.1
scene Catch {
    surface { size: 960, 540; kind: window; title: "pleamar · star catcher"; keyboard: on_demand }
    permissions { services: "sound", "gamepad" }
    shader sea = file "shaders/tide.wgsl"
    figure boat = file "pieces/boat.svg"

    let ink = #f5f7f5
    let mint = #5ef2b0
    let gold = #ffd166

    // What the logic says, sixty times a second or more.
    fact bx: number = 480
    fact lean: number = 0
    fact score: number = 0
    fact lives: number = 5
    fact over = false
    fact fps: number = 0
    fact at.x: number = 480
    fact at.y: number = 300
    event caught
    event missed
    model stars max 28 { x: number; y: number; spin: number; rare: bool }

    // Drawn for 960 × 540, stretched to the window.
    let k = min(screen.width / 960, screen.height / 540)
    let ox = (screen.width - 960 * k) / 2
    let oy = (screen.height - 540 * k) / 2
    let c = mod(time, 16)
    let s1 = c * 45
    let s2 = c * 90
    let level = 410
    let by = level + 9 * sin(bx * 0.75057 + s1) + 5 * sin(bx * 1.67877 + 74.485 - s2)
    let slope = atan2(0.1179 * cos(bx * 0.75057 + s1) + 0.1465 * cos(bx * 1.67877 + 74.485 - s2), 1)

    // A hit is felt: the score swells, the screen takes a knock.
    prop bump = 0 ~spring(260, 12)
    prop knock = 0 ~spring(300, 14)
    on caught { impulse bump 9 }
    on missed { impulse knock 160 }
    prop ended = 0 ~calm
    follow ended = over

    group {
        pivot: 0, 0
        scale: k
        move: ox, oy + knock * 0.05

        shader sea { at: -960, -540; size: 2880, 1620; values: c, level, 0.3, 1, 0, 0, 960, 540; colors: mint, #7a6cff }

        // The stars, each with a halo of its own: a glow over all of them at
        // once would read thirty-two points for every pixel of the sky.
        group {
            for s in stars {
                ellipse { at: s.x, s.y; radius: 21; color: if(s.rare, #ff8fae, gold); opacity: 16% }
                ellipse { at: s.x, s.y; radius: 15; color: if(s.rare, #ff8fae, gold); opacity: 20% }
                path { at: s.x, s.y; rotate: s.spin * 1deg; color: if(s.rare, #ff8fae, gold)
                       move 0.0, -12.0
                           line 2.9, -4.0
                           line 11.4, -3.7
                           line 4.8, 1.5
                           line 7.1, 9.7
                           line 0.0, 5.0
                           line -7.1, 9.7
                           line -4.8, 1.5
                           line -11.4, -3.7
                           line -2.9, -4.0
                           close }
            }
        }

        group {
            pivot: bx, by
            rotate: (slope * 1.3 + lean) * 1deg
            figure boat.mast { at: bx, by - 26; size: 92, 92 }
            figure boat.sail { at: bx, by - 26; size: 92, 92 }
            figure boat.jib  { at: bx, by - 26; size: 92, 92 }
            figure boat.flag { at: bx, by - 26; size: 92, 92; pivot: 2, -42; rotate: sin(c * 270) * 9deg }
            figure boat.hull { at: bx, by - 26; size: 92, 92 }
            figure boat.keel { at: bx, by - 26; size: 92, 92 }
        }
        shader sea { at: -960, -540; size: 2880, 1620; values: c, level, 0.3, 1, 1, 0, 960, 540; colors: mint, #7a6cff }

        group {
            glow: 7, 90%
            particles { at: at.x, at.y; count: 60; life: 0.4s .. 1s; speed: 60 .. 260; gravity: 0, 300; drag: 1.2
                        size: 4, 0.5; colors: #ffffff, gold; shape: spark; burst: caught }
            particles { at: at.x, level; count: 40; life: 0.4s .. 0.9s; speed: 80 .. 220; direction: -90deg; spread: 70deg; gravity: 0, 520
                        size: 3.5, 1; colors: #e6fff6, mint; shape: dot; burst: missed }
        }

        // The score, and what is left: a boat for each life.
        group {
            pivot: 44, 44
            scale: 0.5 * (1 + bump * 0.012)
            text number(score) { at: 44, 44; anchor: left center; size: 72; weight: 800; family: "Inter"; color: ink
                                 shadow: 0, 4, 16, 50%, #02141c }
        }
        repeat n in 0..5 {
            figure boat { at: 916 - n * 40, 40; size: 34, 34; opacity: if(lives > n, 1, 0.18) }
        }
        group {
            pivot: 480, 524
            scale: 0.5
            text "← →  ·  A D  ·  or a game controller      {fps} frames a second" { at: 480, 524; anchor: center; size: 23; weight: 500; family: "Inter"; color: ink; opacity: 45% }
        }

        // The end.
        box { from: -960, -540; size: 2880, 1620; color: #02060c; opacity: 55% * ended }
        group {
            pivot: 480, 250
            scale: 0.5 * (0.8 + 0.2 * ended)
            opacity: ended
            text "the tide took them" { at: 480, 250; anchor: center; size: 112; weight: 800; family: "Inter"; color: ink }
            text "space, or A on the pad, to sail again" { at: 480, 250 + 130; anchor: center; size: 38; weight: 500; family: "Inter"; color: mint }
        }
    }
}
