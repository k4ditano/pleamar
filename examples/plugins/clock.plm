// A plugin: a library with its logic beside it (clock.luau). It brings a component,
// its own boundary —which lives under its name: `Clock.now`— and the permissions its
// logic needs, which are its own and not those of the scene that uses it.

import "../common/palette.plm"

library Clock strict {
    //  Not one process: the clock is a service. `clock.seconds` fires every second.
    permissions { services: "clock" }

    text now = "--:--"
    text day = ""
    fact seconds = false                  // the scene can ask for them: `Clock.seconds = true`
    event tapped ->                       // it reaches the plugin's logic, and nobody else's

    component Clock(tone: color = ink) {
        row face { padding: 9; gap: 8; align: center; fill: coal; corner: 14; cursor: pointer
            text now { size: 14; weight: 600; color: tone }
            text day { size: 11.5; color: tone; opacity: 55% }
        }
        on press face { emit tapped }
    }
}
