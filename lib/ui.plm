// pleamar's own pieces: `import "pleamar:ui"`.
//
// Each one answers the mouse by itself —it lights up under the pointer and
// gives a little when pressed— and says what happened through the event it
// is given: the scene decides what that does. They are drawn from their own
// corner, so they fit in a `row`, a `column` or a cell of a `grid`.
language 0.1
library Ui {

    //  A switch. `on` is whether it is on (an expression: `following`),
    //  and `press` the event fired when it is pressed: the scene toggles.
    //
    //      Switch(following, flip)          on flip { toggle following }
    component Switch(on: number, press: event, accent: color = #9ed6bd) {
        size: 44, 24
        prop pos = 0 ~200ms
        follow pos = if(on > 0.5, 1, 0)
        box { at: 22, 12; size: 44, 24; corner: 12; color: mix(#3a3d40, accent, pos); opacity: 1 - 0.15 * touch.pressed }
        ellipse { at: 12 + 20 * pos, 12; radius: 9 + touch.hover; color: #f6f6f5 }
        zone box touch { at: 22, 12; size: 56, 34; corner: 17; cursor: pointer }
        on press touch { emit press }
    }

    //  A round choice: the ring, and the dot when it is the chosen one.
    component Radio(on: number, press: event, accent: color = #9ed6bd) {
        size: 20, 20
        prop pos = 0 ~180ms
        follow pos = if(on > 0.5, 1, 0)
        ellipse { at: 10, 10; radius: 9 + touch.hover; stroke: 1.6; color: mix(#8b8f95, accent, pos) }
        ellipse { at: 10, 10; radius: 5 * pos; color: accent }
        zone box touch { at: 10, 10; size: 30, 30; corner: 15; cursor: pointer }
        on press touch { emit press }
    }

    //  Two or three choices in a pill, with the chosen one's background
    //  sliding to it. `value` is which one (0, 1, 2); `press` carries the one
    //  pressed: `on pick { mode = pick }`… or whatever the scene makes of it.
    component Segmented(value: number, a: text, b: text, press: event, c: text = "", count: number = 2, width: number = 184) {
        size: width, 30
        prop pos = 0 ~quick
        follow pos = value
        let seg = width / count
        box { at: width / 2, 15; size: width, 30; corner: 15; color: #ffffff; opacity: 8% }
        box { at: seg / 2 + pos * seg, 15; size: seg - 4, 24; corner: 12; color: #ffffff; opacity: 16% }
        repeat i in 0..3 {
            group {
                show: i < count
                text pick(i, a, b, c) { at: seg / 2 + i * seg, 15; anchor: center; size: 11.5; weight: 500; color: #f6f6f5
                                        opacity: 55% + max(0, 1 - abs(pos - i)) * 45% + seg.$i.hover * 20% }
                zone box seg.$i { at: seg / 2 + i * seg, 15; size: seg, 30; corner: 15; cursor: pointer }
            }
            on press seg.$i { emit press(i) }
        }
    }

    //  A tile: a plate that answers the mouse, its name and its value, and a
    //  › that says it opens something. What goes in its round badge on the
    //  left is the scene's: whatever it puts inside.
    //
    //      Tile("Language", "English", open_language, cell.w) { text "Aa" { size: 16 } }
    component Tile(title: text, value: text, press: event, w: number, h: number = 106, accent: color = #9ed6bd) {
        size: w, h
        //  The badge, the title and the value are one block, 84 high, with the
        //  same air above and below it.
        let pad = (h - 84) / 2
        box { at: w / 2, h / 2; size: w, h; corner: 18; color: mix(#25282b, #2c3033, touch.hover); opacity: 1 - 0.1 * touch.pressed }
        box { at: w / 2, h / 2; size: w, h; corner: 18; stroke: 1.2; color: accent; opacity: touch.hover * 45% }
        ellipse { at: 40, pad + 22; radius: 22; color: #ffffff; opacity: 7% + touch.hover * 5% }
        column badge {
            at: 40, pad + 22
            anchor: center middle
            children
        }
        text title { at: 18, pad + 60; anchor: left center; size: 13; weight: 600; width: w - 52; lines: 1; color: #f5f7f5 }
        text value { at: 18, pad + 77; anchor: left center; size: 11; width: w - 52; lines: 1; color: accent }
        path { at: w - 22, pad + 55; color: #f5f7f5; stroke: 1.8; opacity: 40% + touch.hover * 50%
               move 0, 0; line 5, 5; line 0, 10 }
        zone box touch { at: w / 2, h / 2; size: w, h; corner: 18; cursor: pointer }
        on press touch { emit press }
    }

    //  A table: its plate with its border, its head (up to six columns, `a`
    //  to `f`), a line between rows and one between columns; its rows go
    //  inside it, one under another. Each row is a record with its cells as a
    //  list, as the logic split them; a cell with `chip` (1 blue, 2 green,
    //  3 amber, 4 red, 5 violet) is shown as a chip:
    //
    //      model rows max 20 { list cells max 6 { text: text; chip: number } }
    //      Table(480, rows.count, columns: 3, a: "Workstream", b: "Owner", c: "Status") {
    //          repeat r in rows { TableRow(r, 480, columns: 3) }
    //      }
    component Table(w: number, rows: number, columns: number = 3, a: text = "", b: text = "", c: text = "", d: text = "", e: text = "", f: text = "", row: number = 34, head: number = 32, accent: color = #9ed6bd) {
        size: w, head + rows * row
        let col = w / columns
        let tall = head + rows * row
        box { at: w / 2, tall / 2; size: w, tall; corner: 12; color: #25282b }
        box { at: w / 2, head / 2; size: w, head; corner: 12; color: #ffffff; opacity: 4% }
        repeat i in 0..6 {
            text pick(i, a, b, c, d, e, f) { show: i < columns; at: 12 + i * col, head / 2; anchor: left center; size: 11.5; weight: 600; width: col - 16; lines: 1; color: #f5f7f5; opacity: 70% }
        }
        box { at: w / 2, head; size: w, 1; color: accent; opacity: 35% }
        repeat k in 0..63 {
            box { show: k < rows - 1; at: w / 2, head + (k + 1) * row; size: w - 16, 1; color: #ffffff; opacity: 7% }
        }
        repeat i in 1..6 {
            box { show: i < columns; at: i * col, tall / 2; size: 1, tall - 12; color: #ffffff; opacity: 7% }
        }
        box { at: w / 2, tall / 2; size: w, tall; corner: 12; stroke: 1; color: #ffffff; opacity: 12% }
        column body {
            at: 0, head
            children
        }
    }

    //  A row of a `Table`: the cells of its record (`r.cells`: `text`, and
    //  `chip` 0 for a plain cell), each in its column, cut to one line. `tone`
    //  is the colour of the plain ones.
    component TableRow(r: record, w: number, columns: number = 3, row: number = 34, tone: color = #f5f7f5) {
        size: w, row
        let col = w / columns
        repeat i in 0..6 {
            measure cell.$i
            let chip = r.cells[i].chip
            let hue = pick(max(chip - 1, 0), #74b9ff, #31cf76, #f5b041, #ff6b6b, #b48cff)
            box { show: i < columns and chip > 0; at: 12 + i * col + cell.$i.width / 2, row / 2; size: cell.$i.width + 16, 22; corner: 11; color: hue; opacity: 18% }
            text r.cells[i].text { show: i < columns; measure: cell.$i; at: 12 + i * col + if(chip > 0, 8, 0), row / 2; anchor: left center; size: 13; width: col - 24; lines: 1; tight: true; color: if(chip > 0, hue, tone) }
        }
    }

    //  A plate to put things on, with its padding: what goes inside is the
    //  scene's, in a column.
    component Card(w: number, h: number, padding: number = 16) {
        size: w, h
        box { at: w / 2, h / 2; size: w, h; corner: 16; color: #25282b }
        column inside {
            at: padding, padding
            gap: 8
            children
        }
    }
}
