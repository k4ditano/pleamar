// expect: error «'row.hover' lives in the page»
// Not its zones either, nor what is lit on them.
scene ReachedZone {
    surface { size: 300, 160 }
    fact panel: none | settings = none
    fact wifi = true
    event asked
    let ink = #f5f7f5
    let x0 = 20
    include "parts/settings-page.plm" while panel == settings
    box { from: 10, 10; size: 20, 20; color: ink; opacity: row.hover }
}
