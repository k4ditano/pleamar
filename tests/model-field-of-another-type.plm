// expect: error «field 'enabled' of 'rows' is bool, and here a text is needed»
scene Bad3 {
    surface { size: 300, 200 }
    model rows max 3 { label: text; enabled: bool = true }
    column list { at: 10, 10
        for r in rows { Row(r) }
    }
    component Row(r) {
        size: 200, 30
        text r.label { at: 0, 15; size: 13; color: #fff; opacity: r.enabeld }
        text r.enabled { at: 0, 15; size: 13; color: #fff }
    }
}
