// expect: ok
// `keep forever`: built the first time it opens and never let go.
scene KeptForever {
    surface { size: 300, 160 }
    fact panel: none | settings = none
    fact wifi = true
    event asked
    let ink = #f5f7f5
    let x0 = 20
    include "parts/settings-page.plm" while panel == settings keep forever
}
