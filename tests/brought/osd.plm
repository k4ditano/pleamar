// expect: note «Bar is not brought in here»
// Brought into brought-scenes.plm as Osd, beside Bar: it reads Bar's volume, hears
// Bar's `rang` and tells Bar `ping`. Opened alone it still opens: Bar is only used.
uses scene "bar.plm" as Bar
scene Osd {
    surface { size: 100, 100 }
    fact volume = 0
    box hit { from: 0, 0; size: 50 + Bar.volume, 50 }
    on press hit { volume = 1; emit Bar.ping; emit Bar.landed(id: 3, x: local.x) }
    on Bar.rang { volume = Bar.volume }
}
