library Counter strict {
    permissions { run: "date" }
    fact count = 0
    fact mode: idle | busy = idle
    text label = "zero"
    model steps max 3 { name: text }
    event bumped ->
    component Counter(tone: color = #fff) {
        size: 120, 20 + list.height
        text "{label} · {count} · {mode}" { at: 0, 10; anchor: left center; size: 12; color: tone }
        column list { at: 0, 20; for s in steps { text s.name { size: 11; color: tone } } }
        box hit { from: 0, 0; size: 120, 20; color: tone; opacity: if(mode == busy, 20%, 0) }
        on press hit { emit bumped; count = count + 1 }
    }
}
