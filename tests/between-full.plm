// expect: ok
language 0.1
// `between` with its position (`between i`), with several things (it acts as a group,
// with `size:`), and a slot named like a component of the scene.
scene BetweenWhole {
    surface { size: 320, 200 }
    let ink = #f5f7f5
    fact second = true

    component header { size: 40, 10; box { from: 0, 0; size: 40, 10; color: #e86a9a } }
    component Panel {
        size: 300, 30 + rows.height
        row top { at: 10, 6; children header }
        column rows { at: 10, 24; gap: 12
            children
            //  The first line, after the list's header, stronger than the others.
            between i { box { size: 280, 1; color: ink; opacity: if(i == 1, 50%, 12%) } }
        }
    }

    column { at: 10, 10; gap: 16
        Panel {
            header { text "the slot, not the component" { size: 12; color: ink } }
            text "one" { size: 13; color: ink }
            text "two" { size: 13; color: ink; show: second }
            text "three" { size: 13; color: ink }
        }
        row dots { gap: 20
            repeat k in 0..3 { ellipse { radius: 6; color: #9ed6bd } }
            between { size: 10, 12
                box { from: 4, 0; size: 2, 12; color: ink; opacity: 30% }
                ellipse { at: 5, 6; radius: 2.5; color: #e8c07a }
            }
        }
        header
    }
}
