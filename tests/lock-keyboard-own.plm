// expect: ok
// A lock screen asks for the keyboard whatever the first surface says: here the
// first one says nothing, so it has none (pleamar-wm#38).
scene LockKeyboardOwn {
    fact locked = false
    text password = ""
    surface { size: 1, 1; anchor: top_left; level: background }
    surface lk {
        kind: lock
        open: locked
        size: 640, 440
        input password { at: 20, 20; width: 300; size: 14; secret: true }
    }
}
