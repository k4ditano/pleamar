// expect: error «'Row' is missing 'chosen' (an event): it is Row(r: record, chosen: event, tone: color = …)»
scene X {
    surface { size: 100, 100 }
    model rows max 2 { label: text }
    event choose
    component Row(r: record, chosen: event, tone: color = #fff) { size: 10, 10; box hit { size: 10, 10; color: tone }; on press hit { emit chosen } }
    column { at: 0, 0; for r in rows { Row(r) } }
}
