// The anchors and levels of a surface: a scene has only one, so they go one at a time.
scene Surface3 {
    surface { size: 200, 60; anchor: bottom_left; margin: 8, 12, 8, 12; level: overlay; reserve: 0; screens: all }
    box { at: 100, 30; size: 180, 40; corner: 20; color: #151616 }
}
