// expect: ok
language 0.9
import "pleamar:ui"
// The library's pieces, together: each answers the mouse by itself.
scene Gallery {
    surface { size: 520, 460 }
    fact on = true
    fact tab = 0
    fact choice = 0
    fact level = 0.4
    fact toasting = 0
    event flip
    event pick_tab
    event pick
    event set_level
    event picked
    on flip { toggle on }
    on pick_tab(v) { tab = v }
    on pick(v) { choice = v }
    on set_level(v) { level = v }
    image me = data "me", 32, 32
    model items max 4 { label: text; separator: number; enabled: number = 1; checked: number = -1; children: number }
    column { at: 20, 20; gap: 14
        Checkbox(on, flip, label: "Notify on finish")
        Button("Install agent", flip, 180)
        Button("Cancel", flip, 120, kind: 2)
        Tabs(tab, "Agents", "Plugins", pick_tab, count: 2, width: 220)
        Slider(level, set_level, w: 220)
        row { gap: 8; align: center
            Chip("@launch-brief.md")
            Chip("@Research", tone: #31cf76)
            Avatar(me)
        }
        Tooltip("Copies the answer", on, w: 160)
        Toast("Saved", toasting)
    }
    Menu(220, 130) {
        move: 280, 20
        for r in items { MenuRow(r, picked) }
    }
    Select(choice, "Today", "This week", pick, c: "This month", count: 3, w: 200)
}
