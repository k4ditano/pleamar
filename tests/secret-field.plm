// expect: ok
language 0.1
// A password field: it is typed the same, it is painted as dots, and what it holds
// never shows up in any log. The check belongs to the logic: sys.ask("auth.check", …).
scene Password {
    surface { size: 300, 80; anchor: top; keyboard: on_demand }
    permissions { services: "auth" }
    text password = ""
    box { from: 20, 20; size: 260, 40; corner: 10; color: #202021 }
    input password { at: 34, 30; width: 232; size: 15; color: #ffffff; placeholder: "password"; secret: true }
}
