// expect: ok
language 0.1
// `while` works on any rule, not only on `idle` and `every`.
scene RuleWhile {
    surface { size: 200, 60 }
    fact armed = false
    fact hits = 0
    event ping
    box button { at: 100, 30; size: 120, 34; corner: 17; color: #2e2f2f }
    on press button while armed          { hits = hits + 1 }
    on hover button for 200ms while not armed { armed = true }
    on ping while armed and hits < 3     { hits = 0 }
    on key Escape while armed            { armed = false }
    every 2s..4s while armed             { hits = hits + 1 }
}
