// expect: error «'row_glow' lives in the page `parts/settings-page.plm`»
// What a page declares is not named from outside it: it is not always there.
scene Reached {
    surface { size: 300, 160 }
    fact panel: none | settings = none
    fact wifi = true
    event asked
    let ink = #f5f7f5
    let x0 = 20
    include "parts/settings-page.plm" while panel == settings
    box { from: 10, 10; size: 20, 20; color: ink; opacity: row_glow }
}
