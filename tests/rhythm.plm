// expect: ok
language 0.1
// `rate: 30`: at most thirty frames per second, on any monitor.
// What a scene that is always moving consumes stops depending on the
// screen it happens to land on.
scene Rhythm {
    surface { size: 200, 80; anchor: top; rate: 30 }
    prop t = 0
    wave t = 1 at 0.5
    box { at: 100 + t * 40, 40; size: 20, 20; corner: 6; color: #9ed6bd }
}
