// expect: ok
// A model, a `for` inside a layout and another loose one, a record passed to a
// component, `index`, `count` and `total`, and a record named by hand.
scene ModelAndFor {
    surface { size: 300, 200 }
    model rows max 4 { label: text = "—"; enabled: bool = true; depth: number }
    event pick ->
    column list { at: 10, 10; gap: 2
        for r in rows { Row(r) }
    }
    component Row(r) {
        size: 200, 24 + r.depth * 4
        box hit { from: 0, 0; size: 200, 24; corner: 6; color: #9ed6bd; opacity: 20%; active: r.enabled }
        text r.label { at: 8 + r.depth * 12, 12; anchor: left center; size: 13; color: #fff }
        on press hit { emit pick(r.index) }
    }
    for r in rows { ellipse { at: 250, 20 + r.index * 12; radius: 3; color: #fff; opacity: r.enabled } }
    text rows.0.label { at: 150, 180; anchor: center; size: 12; color: #fff; opacity: rows.total > rows.count }
}
