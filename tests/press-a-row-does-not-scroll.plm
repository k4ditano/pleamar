// expect: ok
language 0.1
// A press on a row of a list that scrolls, with the mouse moving a pixel or two
// as it clicks, does not scroll it: where the list was is noted on any press
// over it (on a row too), and a drag reaches the list under the row only once
// the pointer has gone a few pixels. The chat used to fly to its top.
scene Chat {
    surface { size: 300, 200 }
    model rows max 20 { label: text }
    fact opened = 0
    column chat {
        at: 10, 10
        view: 280, 180
        stick: end
        keep: visible
        for r in rows {
            group {
                size: 280, 30
                zone box row { from: 0, 0; size: 280, 28 }
                text r.label { at: 8, 15; anchor: left center; size: 12; color: #f5f7f5 }
                on press row { opened = opened + 1 }
            }
        }
    }
    text "{chat.scroll, 0} {opened, 0}" { at: 200, 190; size: 10; color: #ffd166 }
}
