// expect: ok
language 0.1
// One bar per monitor, each with its own state: `screens: each`. Inside, `$screen` is
// its number, `screen.name` its monitor's, and what is declared is its own and nobody else's.
scene PerScreen {
    let ink = #f5f7f5
    model bars max 4 { active: number; title: text }

    surface bar {
        size: full, 36
        anchor: top
        screens: each max 2

        prop lift = 0 ~quick               // one per copy: each bar lights up on its own
        box strip { at: screen.width / 2, 18; size: screen.width, 36; color: mix(#151616, #23312c, lift) }
        text "{screen.name} · {bars.$screen.title}" { at: 12, 18; anchor: left center; size: 12.5; color: ink }
        row desks { at: screen.width - 12, 18; anchor: right middle; gap: 5
            repeat i in 0..4 {
                box dot { size: 16, 16; corner: 8; color: ink
                          opacity: if(bars.$screen.active == i, 90%, 25%) }
            }
        }
        on enter strip { lift: 1 ~quick }
        on leave strip { lift: 0 ~quick }
    }
}
