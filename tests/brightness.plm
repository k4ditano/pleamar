// expect: ok
language 0.1
// The screen brightness, like the battery: a desktop answers that there is
// none, and then the track shows dimmed instead of lying.
scene Brightness {
    surface { size: 120, 220; anchor: top }
    permissions { services: "brightness", "brightness.*" }
    service brightness as display { present: bool; level: number }
    event drag_to ->

    prop level = 0 ~quick
    follow level = display.level

    box { from: 0, 0; size: 120, 220; color: #151616 }
    group {
        opacity: 25% + if(display.present, 75%, 0%)
        box { at: 60, 100; size: 14, 150; corner: 7; color: #2a2b2c }
        box { from: 53, 25 + 150 * (1 - level); size: 14, 150 * level; corner: 7; color: #9ed6bd }
        ellipse { at: 60, 25 + 150 * (1 - level); radius: 9; color: #f0ece4 }
    }
    text "{level * 100, 0}%" { at: 60, 196; anchor: center; size: 11.5; color: #9ed6bd }
    zone box track { at: 60, 100; size: 34, 168; cursor: pointer }
    on drag track { emit drag_to(1 - clamp((pointer.y - 25) / 150, 0, 1)) }
}
