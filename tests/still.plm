// expect: ok
language 0.1
// `on still x for t`: when that expression has held the same value for that long. It is the
// reverse of `on change`, and what makes a burst —the volume key
// pressed six times— one single reading and not six.
scene Still {
    surface { size: 200, 60; anchor: top }
    permissions { services: "audio" }
    service audio as sound { volume: number; muted: bool }

    prop meter = 0 ~180ms
    prop level = 0 ~quick

    follow level = sound.volume
    on change sound.volume { meter: 1 }
    on still sound.volume for 1.1s { meter: 0 }

    box { from: 0, 0; size: 200, 60; color: #151616 }
    box { at: 100, 30; size: 120, 6; corner: 3; color: #2b2d2d; opacity: meter }
    box { from: 40, 27; size: 120 * level, 6; corner: 3; color: mix(#9ed6bd, #6b7280, sound.muted); opacity: meter }
    text number(sound.volume * 100, 0, " %") { at: 100, 14; anchor: center; size: 10; color: #f5f7f5; opacity: meter }
}
