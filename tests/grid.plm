// expect: ok
language 0.1
// `wrap`: a grid. Five per line, and what is not shown leaves no gap.
scene Grid {
    surface { size: 340, 300 }
    let ink = #f5f7f5
    fact everything = true
    box { from: 0, 0; size: 340, 300; color: #151616 }

    row tiles ~calm {
        at: 20, 20
        gap: 10
        wrap: 5
        repeat i in 1..15 {
            group {
                size: 50, 50
                zone box hit { from: 0, 0; size: 50, 50; cursor: pointer }
                show: everything or i <= 6
                box { from: 0, 0; size: 50, 50; corner: 12; color: mix(#9ed6bd, #e8c07a, i / 14) }
                text "{i}" { at: 25, 25; anchor: center; size: 13; weight: 600; color: #151616 }
            }
        }
    }
    text "wrap: 5 · {tiles.count} tiles" { at: 20, 260; size: 11; color: ink; opacity: 45% }
    zone box all { from: 0, 250; size: 340, 50 }
    on press all { toggle everything }
}
