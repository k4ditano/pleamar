// expect: ok
scene Grid {
    surface { size: 480, 300 }
    fact chosen = -1
    grid {
        at: 12, 12; columns: 2; gap: 12; width: 456; row: 80
        repeat t in 0..5 {
            group {
                span: if(t == 4, 2, 1)
                prop lift.$t = 0 ~lively
                on press tile.$t { chosen = t; impulse lift.$t 6 }
                box { at: cell.w / 2, cell.h / 2 - lift.$t; size: cell.w, cell.h; corner: 14
                      color: mix(#25282b, #2f3a37, tile.$t.hover); opacity: 1 - 0.2 * tile.$t.pressed }
                box { at: cell.w / 2, cell.h / 2; size: cell.w, cell.h; corner: 14; stroke: 1.2; color: #9ed6bd; opacity: if(chosen == t, 0.9, 0) }
                text pick(t, "Home", "Look", "Language", "Lock", "Wardrobe") { at: 16, 30; anchor: left center; size: 13; weight: 600; color: #f5f7f5 }
                zone box tile.$t { at: cell.w / 2, cell.h / 2; size: cell.w, cell.h; corner: 14; cursor: pointer }
            }
        }
    }
}
